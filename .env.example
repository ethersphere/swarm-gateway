# Required
GATEWAY_HOSTNAME=gateway.example.com
DATABASE_PASSWORD=
BEE_PASSWORD=

# Required unless BEE_SWAP_ENABLE=false
BEE_BLOCKCHAIN_RPC_ENDPOINT=
BEE_NAT_ADDR=

# Ethereum mainnet RPC, required to resolve .eth subdomains. Separate from the
# Gnosis endpoint above. Format: [tld:][contract-addr@]url
BEE_RESOLVER_OPTIONS=

# Optional. Leave lines out entirely rather than blank where a number is expected.
#BEE_SWAP_ENABLE=false
#INSTANCE_NAME=dev
#POSTAGE_AMOUNT=800000000
#POSTAGE_DEPTH=17
#ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
#LOG_LEVEL=info
