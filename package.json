{
  "name": "swarm-gateway",
  "version": "0.1.0",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "depcheck": "npx --yes depcheck",
    "format": "prettier --write \"{src,test}/**/*.ts\"",
    "format:check": "prettier --check \"{src,test}/**/*.ts\"",
    "test": "tsc -p tsconfig.test.json && node --test build-test/test/*.test.js"
  },
  "license": "BSD-3-Clause",
  "dependencies": {
    "@ethersphere/bee-js": "^13.2.0",
    "cafe-utility": "^34.0.0",
    "express": "^5.3.0",
    "mysql2": "^3.24.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  }
}
